{
  "name": "@framefind/react",
  "version": "0.1.2",
  "description": "React hooks for FrameFind glasses detection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moraxh/FrameFind"
  },
  "dependencies": {
    "@framefind/core": "workspace:*",
    "@framefind/utils": "workspace:*"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.18.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "typescript": "^5.5.0"
  }
}
